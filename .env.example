# Porta HTTP do servidor (produção). Dev usa a API na porta 3000.
PORT=3000

# Segredo usado para assinar os tokens JWT. Gere um aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Opcional: caminho do arquivo SQLite. Padrão: <raiz>/data/db.sqlite
# DB_PATH=./data/db.sqlite

# Opcional (produção persistente): string de conexão do Postgres/Supabase
# DATABASE_URL=postgresql://...